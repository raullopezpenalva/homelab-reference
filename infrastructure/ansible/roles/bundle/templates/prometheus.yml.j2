global:
  scrape_interval: 30s
rule_files:
  - /etc/prometheus/rules.yml
scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: [localhost:9090]
  - job_name: reference-guests
    static_configs:
{% for host in groups['all'] | sort %}
{% if hostvars[host].ansible_host is defined %}
      - targets: ['{{ hostvars[host].ansible_host }}:9100']
        labels:
          role: '{{ hostvars[host].lab_role }}'
{% endif %}
{% endfor %}
